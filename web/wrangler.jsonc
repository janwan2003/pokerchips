{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easypoker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects: each table's journal is a SQL table. Never delete
  // this migration or rename the class — that would drop every table's history.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "routes": [
    { "pattern": "easypoker.cc", "custom_domain": true },
    { "pattern": "www.easypoker.cc", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
